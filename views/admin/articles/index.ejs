<link rel="stylesheet" href="/tabulator/css/tabulator.min.css"> 
<div id="admin-content">
    <div class="container">
        <div class="row">
            <div class="col-md-10">
                <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
            </div>
            <div class="col-md-2">
                <a class="add-new" href="/admin/add-article">Add New Article</a>
            </div>
            <div class="col-md-12">
                <div id="articleTable"></div>
            </div>
        </div>
    </div>
</div>

<!-- Tabulator JS -->
<script src="/tabulator/js/tabulator.min.js"></script>

<script>

  
  const articles = <%- JSON.stringify(articles) %>;

    const table = new Tabulator("#articleTable", {
        data: articles,

        layout: "fitColumns",

        pagination: true,
        paginationSize: 10,
        paginationSize: 10,
        paginationSizeSelector:[5,10,25,50,100],
        columns: [
            {
                title:"S.NO.",
                formatter:"rownum",
                width:100,
                hozAlign:"center"
            },
            {
                title: "Title",
                field: "title",
                headerFilter: "input"
            },
            {
                title: "Category NAme",
                field: "category.name",
                headerFilter: "input"
            },
            {
                title: "Author",
                field: "author.fullname",
                headerFilter: "input"
            },
            {
              title:"Actions",
              formatter: function(cell, formatterParams, onRendered){
                return `
                <a href="/admin/update-article/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
                <button class="btn btn-sm btn-danger delete-article" onClick="deleteArticle('${cell.getData()._id}')">Delete</button>
                `
              }
            }
        ]
    });


    async function deleteArticle(id){
      try{
        if(confirm("Are you sure you want to delete this article ?")){
          const response = await fetch(`/admin/delete-article/${id}`, {
            method:'delete'
          })
          if(response.ok){
            window.location.reload()
          }
        }
      }catch(err){
        console.log(err)
      }
    }


</script>