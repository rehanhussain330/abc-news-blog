 <div id="admin-content">
      <div class="container">
          <div class="row">
              <div class="col-md-12">
                <h1 class="admin-heading"><i class="fa fa-cog"></i> Settings</h1>
              </div>
              <div class="col-md-6 mx-auto">
                  <div class="card">
                    <h5 class="card-header">Settings</h5>
                    <div class="card-body">
                      <form action="/admin/save-settings" method="POST" enctype="multipart/form-data">
                          <div class="mb-3">
                              <label for="website_title" class="form-label">Website Title</label>
                              <input type="text" value="<%= settings && settings.website_title ? settings.website_title:'' %>" name="website_title" class="form-control" autocomplete="off" required="">
                          </div>
                          <div class="mb-3">
                              <label for="website_logo" class="form-label">Upload Logo</label><br>
                              <% if(settings && settings.website_logo && settings.website_logo.trim() !== ''){ %>
                                <img src="/uploads/<%= settings.website_logo %>" alt="" class="mb-3 w-25">
                              <% } %>
                              <input type="file" name="website_logo" class="form-control">
                          </div>
                          <div class="mb-3">
                              <label for="footer_description" class="form-label">Footer Description</label>
                              <input type="text" value="<%= settings && settings.footer_description ? settings.footer_description : '' %>" name="footer_description" class="form-control" autocomplete="off" required="">
                          </div>
                          <input type="submit" class="btn btn-primary" value="Save">
                      </form>
                    </div>
                  </div>
              </div>
          </div>
      </div>
  </div>